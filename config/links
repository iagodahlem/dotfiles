# Link table read by scripts/install-dotfiles.sh, one entry per line: source  target  [os]
#
# source  path under config/. A trailing / links the whole directory, without it only that file.
# target  path under ~, written with a leading ~/. Missing parent directories are created.
# os      macos or linux. Leave it out to link on both.
#
# Link a directory when the tool owns all of it, and a single file when the tool keeps other things in the same directory.
# Untracked files that have to sit inside a linked directory (git's host and local, mise's conf.d) live in the checkout under config/ and are gitignored.

zsh/.zshenv            ~/.zshenv
zsh/                   ~/.config/zsh
tmux/                  ~/.config/tmux
nvim/                  ~/.config/nvim
git/                   ~/.config/git
ghostty/               ~/.config/ghostty
mise/                  ~/.config/mise
