# Copy this file to config/git/local, inside the checkout, and fill in the identity for THIS machine.
#
# config/git/config ends with `[include] path = ~/.config/git/local`,
# and git applies includes last, so anything set here wins over the defaults
# baked into the tracked config (name, email, signing key).
#
# ~/.config/git links to config/git, so ~/.config/git/local is this same file.
# config/git/local is gitignored and never committed, so it is safe to put
# the email for this machine here. It exists only in this checkout: back it up
# before deleting the checkout, and note that `git clean -x` removes it.
#
# On a new work machine, create this file BEFORE the first commit. Without
# it, commits silently use the default identity from config/git/config.

[user]
  email = you@this-machine.example
  # Uncomment only if this machine uses a different name than the default:
  # name = Your Name
  # Uncomment only if this machine signs with a different key than the
  # default (~/.ssh/id_ed25519.pub):
  # signingkey = ~/.ssh/id_ed25519_machine.pub

# A machine with no signing key (a work machine where SSH keys aren't
# allowed, for example) can't satisfy config/git/config's `commit.gpgsign =
# true`, and leaving `signingkey` empty above doesn't help: every commit
# still fails. Uncomment this block to turn signing off on this machine:
# [commit]
#   gpgsign = false
#
# A repo that requires signed commits then needs a key used only for
# signing, registered on the hosting account (GitHub, for example) as a
# signing key. Signing is local, so that key works even on a machine
# where ssh to the host itself is blocked.
