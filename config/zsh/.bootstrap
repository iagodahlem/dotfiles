for FILE in $DOTFILES_ZSH/.{exports,aliases,functions}; do
  [ -r "$FILE" ] && source "$FILE"
done
unset FILE

source "$DOTFILES/scripts/utils/os.sh"
OS_ID="$(os_id)"

load_overlay() {
  local overlay_root="$1"
  local zsh_dir="$overlay_root/zsh"
  [ -d "$zsh_dir" ] || return 0
  for FILE in "$zsh_dir"/.{exports,aliases,functions,bootstrap}; do
    [ -r "$FILE" ] && source "$FILE"
  done
}

# OS overlay
load_overlay "$DOTFILES/overlays/os/$OS_ID"

# Host overlay (optional)
if [ -n "${DOTFILES_HOST:-}" ]; then
  load_overlay "$DOTFILES/overlays/host/$DOTFILES_HOST"
fi

unset OS_ID

source "$DOTFILES_CONFIG"/mise/.mise
source "$DOTFILES_CONFIG"/atuin/.atuin
source "$DOTFILES_CONFIG"/brew/.homebrew
source "$DOTFILES_CONFIG"/cargo/.cargo

# Sets REPLY to the file that loads a zsh add-on (powerlevel10k, zsh-autosuggestions or zsh-syntax-highlighting) and returns 0, or returns 1 when it is not installed.
# The first path that exists wins: Homebrew, the Arch package (powerlevel10k is only in the AUR), the Debian and Ubuntu package (none for powerlevel10k), then the clone scripts/install-shell.sh makes in $ZSH_CUSTOM where no package exists.
# The caller sources REPLY at the top level of .zshrc, because a file sourced inside a function would keep its typeset variables local to it.
# install-shell.sh checks the same package paths (packaged) before it clones, keep the two in step.
find_zsh_addon() {
  local name="$1"
  local file
  local -a candidates

  case "$name" in
    powerlevel10k)
      candidates=(
        ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme}
        /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
        $ZSH_CUSTOM/themes/powerlevel10k/powerlevel10k.zsh-theme
      )
      ;;
    zsh-autosuggestions|zsh-syntax-highlighting)
      candidates=(
        ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share/$name/$name.zsh}
        /usr/share/zsh/plugins/$name/$name.zsh
        /usr/share/$name/$name.zsh
        $ZSH_CUSTOM/plugins/$name/$name.zsh
      )
      ;;
  esac

  REPLY=
  for file in $candidates; do
    if [[ -r $file ]]; then
      REPLY=$file
      return 0
    fi
  done
  return 1
}
