for FILE in $DOTFILES_ZSH/.{exports,aliases,functions}; do
  [ -r "$FILE" ] && source "$FILE"
done
unset FILE

source "$DOTFILES/scripts/utils/os.sh"
source "$DOTFILES/scripts/utils/host.sh"
OS_ID="$(os_id)"

load_overlay() {
  local overlay_root="$1"
  local zsh_dir="$overlay_root/zsh"
  [ -n "$overlay_root" ] && [ -d "$zsh_dir" ] || return 0
  for FILE in "$zsh_dir"/.{exports,aliases,functions,zshrc.local,bootstrap}; do
    [ -r "$FILE" ] && source "$FILE"
  done
}

# OS overlay
load_overlay "$DOTFILES/overlays/os/$OS_ID"

# Host overlay (optional): the private overlays repo's <host>/dotfiles/, else overlays/host/<host>/, see host_overlay_dir
# DOTFILES_HOST comes from .zshenv, the short hostname unless it is already set
load_overlay "$(host_overlay_dir "$DOTFILES")"

unset OS_ID

source "$DOTFILES_CONFIG"/mise/.mise
source "$DOTFILES_CONFIG"/atuin/.atuin
source "$DOTFILES_CONFIG"/brew/.homebrew
source "$DOTFILES_CONFIG"/cargo/.cargo

# Machine-private lines (gitignored, see local.zsh.example), last so they win over everything above
if [ -r "$DOTFILES_ZSH/local.zsh" ]; then
  source "$DOTFILES_ZSH/local.zsh"
fi
