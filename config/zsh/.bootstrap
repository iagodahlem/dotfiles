for FILE in $DOTFILES_ZSH/.{exports,aliases,functions}; do
  [ -r "$FILE" ] && source "$FILE"
done
unset FILE

source "$DOTFILES/scripts/utils/os.sh"
OS_ID="$(os_id)"

load_overlay() {
  local overlay_root="$1"
  local zsh_dir="$overlay_root/zsh"
  [ -d "$zsh_dir" ] || return 0
  for FILE in "$zsh_dir"/.{exports,aliases,functions,bootstrap}; do
    [ -r "$FILE" ] && source "$FILE"
  done
}

# OS overlay
load_overlay "$DOTFILES/overlays/os/$OS_ID"

# Host overlay (optional)
if [ -n "${DOTFILES_HOST:-}" ]; then
  load_overlay "$DOTFILES/overlays/host/$DOTFILES_HOST"
fi

unset OS_ID

source "$DOTFILES"/npm/.npm
source "$DOTFILES"/cargo/.cargo
source "$DOTFILES_CONFIG"/brew/.homebrew
source "$DOTFILES_CONFIG"/asdf/.asdf
source "$DOTFILES_CONFIG"/nvm/.nvm
source "$DOTFILES_CONFIG"/atuin/.atuin
