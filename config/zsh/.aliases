# dotfiles
alias dots="cd $DOTFILES"

# show human friendly numbers and colors
alias df='df -h'
alias du='du -h -d 2'

# override rm -i alias which makes rm prompt for every action
alias rm='nocorrect rm'

# general commands
alias top="btop"

# bat is installed as batcat on Debian
if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
elif command -v batcat >/dev/null 2>&1; then
  alias cat="batcat"
fi

# ls family through eza (exa on older Debian), falling back to plain ls
if command -v eza >/dev/null 2>&1; then
  _ls_bin="eza"
elif command -v exa >/dev/null 2>&1; then
  _ls_bin="exa"
fi
if [ -n "${_ls_bin:-}" ]; then
  alias ls="$_ls_bin --group-directories-first"
  alias l="$_ls_bin -l --group-directories-first --git"
  alias ll="$_ls_bin -l --group-directories-first --git"
  alias la="$_ls_bin -la --group-directories-first --git"
  alias lt="$_ls_bin --tree --level=2 --group-directories-first"
fi
unset _ls_bin

# zsh & oh-my-zsh
alias reload=". $HOME/.zshrc"
alias r="reload"

# docker
alias dc="docker"
alias dcc="docker compose"
