export HISTIGNORE="ls:ls *:cd:cd -:pwd;exit:date:* --help"

# prefer US English and use UTF-8
export LANG=en_US.UTF-8

# editors
export CODE='code'
export VIM='vim'

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR=$VIM
else
  export EDITOR=$CODE
fi

# path
export PATH=/usr/local/bin
export PATH=$PATH:/usr/local/sbin
export PATH=$PATH:/usr/sbin
export PATH=$PATH:/usr/bin
export PATH=$PATH:/sbin
export PATH=$PATH:/bin
export PATH=$PATH:/usr/games
export PATH=$PATH:/usr/local/games
export PATH=$PATH:/snap/bin
export PATH=$PATH:$HOME/.local/bin
export PATH=$PATH:$DOTFILES_BIN

if command -v mkcert >/dev/null 2>&1; then
  _mkcert_ca_root="$(mkcert -CAROOT 2>/dev/null || true)"
  if [ -n "${_mkcert_ca_root:-}" ] && [ -f "$_mkcert_ca_root/rootCA.pem" ]; then
    export NODE_EXTRA_CA_CERTS="$_mkcert_ca_root/rootCA.pem"
  fi
  unset _mkcert_ca_root
fi
