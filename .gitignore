# ~/.config/zsh links into this repo, so keep out what zsh and Terminal.app may still write there
config/zsh/.zcompdump*
config/zsh/.zsh_history
config/zsh/.zsh_sessions/
config/zsh/*.zwc

# ~/.config/git links into this repo, so the machine-local files sit in config/git untracked: the identity, and the host settings the overlays link in
config/git/local
config/git/host
